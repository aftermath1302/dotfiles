* {
    bg: #0B0A10;
    bg-alt: #12101A;
    surface: #171421;
    surface-alt: #1E1A2A;

    fg: #D9E0EE;
    muted: #9691A8;
    accent: #F5BDE6;

    transparent: rgba(0,0,0,0);
}

window {
    width: 420px;
    border: 1px;
    border-color: #302A3F;
    border-radius: 14px;
    background-color: @bg;
    padding: 18px;
}

mainbox {
    children: [inputbar, listview];
    spacing: 14px;
}

inputbar {
    children: [prompt, entry];
    background-color: @surface;
    border-radius: 10px;
    padding: 11px 14px;
}

prompt {
    enabled: true;
    text: "󰉖";
    text-color: @accent;
    padding: 0 10px 0 0;
}

entry {
    placeholder: "Select theme...";
    placeholder-color: @muted;
    text-color: @fg;
    cursor-color: @accent;
}

listview {
    enabled: true;
    lines: 4;
    columns: 1;
    fixed-height: false;
    scrollbar: false;
    spacing: 6px;
}

element {
    padding: 11px 14px;
    border-radius: 9px;
    background-color: @transparent;
}

element-text {
    text-color: @muted;
    font: "Source Code Pro 11";
}

element selected {
    background-color: @surface-alt;
    border: 1px;
    border-color: @accent;
}

element-text selected {
    text-color: @accent;
}